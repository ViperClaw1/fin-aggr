{
  "permissions": {
    "allow": [
      "Shell(pnpm:install)",
      "Shell(pnpm:typecheck)",
      "Shell(pnpm:lint)",
      "Shell(pnpm:lint:canaries)",
      "Shell(pnpm:depcruise)",
      "Shell(pnpm:knip)",
      "Shell(pnpm:format:check)",
      "Shell(pnpm:test)",
      "Shell(pnpm:bench)",
      "Shell(pnpm:golden:check)",
      "Shell(pnpm:build)",
      "Shell(pnpm:bundle:report)",
      "Shell(pnpm:e2e)",
      "Shell(pnpm:rules:sync)",
      "Shell(pnpm:rules:check)",
      "Shell(pnpm:exec)",
      "Shell(pnpm:vitest)",
      "Shell(git:status)",
      "Shell(git:diff)",
      "Shell(git:log)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.development.local)",
      "Read(.env.production)",
      "Read(.env.production.local)",
      "Read(.env.test)",
      "Read(.env.test.local)",
      "Read(apps/web/.env)",
      "Read(apps/web/.env.local)",
      "Read(apps/web/.env.development)",
      "Read(apps/web/.env.development.local)",
      "Read(apps/web/.env.production)",
      "Read(apps/web/.env.production.local)",
      "Read(apps/web/.env.test)",
      "Read(apps/web/.env.test.local)",
      "Write(pnpm-lock.yaml)",
      "Shell(git:push)",
      "Shell(git:reset)",
      "Shell(git:clean)",
      "Shell(rm)",
      "Shell(sudo)",
      "Shell(pnpm:publish)",
      "Shell(npm:publish)"
    ]
  }
}

# Data source: "mock" (fixtures) or "http" (stage 2 stub, every call fails with not_implemented)
NEXT_PUBLIC_DATA_SOURCE=mock

# Seed for deterministic fixtures (read by apps/web/src/shared/config/env.ts)
NEXT_PUBLIC_FA_SEED=20261025

# Simulated gateway failure probability, 0..1 (0 = never fail)
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Origin for canonical and Open Graph URLs, no trailing slash. Empty uses https://fin-aggr.vercel.app
NEXT_PUBLIC_SITE_URL=

# Server-only. Empty means the site is open. Set it on Vercel Production, then redeploy.
DEMO_PASSWORD=

# Directory for synthetic PDFs. Empty uses apps/web/public/mock-docs (tools/build-docs.mjs)
FA_DOCS_OUT=

# Lighthouse CI. pnpm lhci:profile sets this to 1; leave empty for the app.
LHCI_PROFILE=

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

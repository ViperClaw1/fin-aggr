# Data source: "mock" (fixtures), "http" (stub), or "supabase" (server gateway, ADR-019)
NEXT_PUBLIC_DATA_SOURCE=mock

# Seed for deterministic fixtures (read by apps/web/src/shared/config/env.ts)
NEXT_PUBLIC_FA_SEED=20261025

# Simulated gateway failure probability, 0..1 (0 = never fail)
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Origin for canonical and Open Graph URLs, no trailing slash. Empty uses https://fin-aggr.vercel.app
NEXT_PUBLIC_SITE_URL=

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Server-only. Empty means the site is open. Set it on Vercel Production, then redeploy.
DEMO_PASSWORD=

# Directory for synthetic PDFs. Empty uses apps/web/public/mock-docs (tools/build-docs.mjs)
FA_DOCS_OUT=

# Lighthouse CI. pnpm lhci:profile sets this to 1; leave empty for the app.
LHCI_PROFILE=

# Server only. Never NEXT_PUBLIC_. The browser does not talk to Supabase (ADR-019).
# SUPABASE_SECRET_KEY and SUPABASE_DB_URL are for ingest and scripts, not apps/web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bearer secret for POST /api/revalidate. Empty rejects every call.
REVALIDATE_SECRET=
SUPABASE_SECRET_KEY=
# local default when empty: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
SUPABASE_DB_URL_STAGING=
SUPABASE_DB_URL_PROD=

# GitHub login for ingest:approve / ingest:reject / ingest:exclude. Else the CLI runs `gh api user --jq .login`.
# An email is rejected. Actions secret REVIEW_REPO_TOKEN is not stored in this file.
FA_REVIEWER=

# Project mailbox in the scrape User-Agent. Not a personal address. Empty refuses bank-rate runs.
FA_SCRAPE_MAILBOX=

# FRED API key for FDIC national deposit rates. Empty refuses that job. Never commit the key.
FRED_API_KEY=
